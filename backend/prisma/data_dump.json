"FETCH\",\"DELETE\"],\"correctAnswer\":[\"GET\",\"POST\",\"DELETE\"]},{\"questionText\":\"Which of the following are relational database management systems?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"PostgreSQL\",\"MongoDB\",\"MySQL\",\"Redis\"],\"correctAnswer\":[\"PostgreSQL\",\"MySQL\"]},{\"questionText\":\"Which of the following are frontend web technologies?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"React\",\"Vue.js\",\"Node.js\",\"CSS\"],\"correctAnswer\":[\"React\",\"Vue.js\",\"CSS\"]},{\"questionText\":\"Which of the following are Agile development frameworks?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Scrum\",\"Kanban\",\"Waterfall\",\"PRINCE2\"],\"correctAnswer\":[\"Scrum\",\"Kanban\"]},{\"questionText\":\"Which of the following are cloud service providers?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"AWS\",\"Azure\",\"GitHub\",\"GCP\"],\"correctAnswer\":[\"AWS\",\"Azure\",\"GCP\"]},{\"questionText\":\"Which of the following are primitive data types in JavaScript?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"String\",\"Number\",\"Boolean\",\"ArrayList\"],\"correctAnswer\":[\"String\",\"Number\",\"Boolean\"]},{\"questionText\":\"Which of the following are NoSQL databases?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"MongoDB\",\"Cassandra\",\"Oracle\",\"PostgreSQL\"],\"correctAnswer\":[\"MongoDB\",\"Cassandra\"]},{\"questionText\":\"Which of the following are CSS layout modules?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Flexbox\",\"Grid\",\"DOM\",\"Canvas\"],\"correctAnswer\":[\"Flexbox\",\"Grid\"]},{\"questionText\":\"Which of the following are continuous integration tools?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Jenkins\",\"GitHub Actions\",\"Docker\",\"Git\"],\"correctAnswer\":[\"Jenkins\",\"GitHub Actions\"]},{\"questionText\":\"Which of the following are container technologies?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Docker\",\"Podman\",\"Nginx\",\"Apache\"],\"correctAnswer\":[\"Docker\",\"Podman\"]},{\"questionText\":\"Which of the following are valid Linux operating systems?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Ubuntu\",\"Debian\",\"Windows\",\"Fedora\"],\"correctAnswer\":[\"Ubuntu\",\"Debian\",\"Fedora\"]},{\"questionText\":\"Which of the following are HTTP client libraries in JavaScript?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Axios\",\"Fetch API\",\"Express\",\"Prisma\"],\"correctAnswer\":[\"Axios\",\"Fetch API\"]},{\"questionText\":\"Which of the following are web security mechanisms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"CORS\",\"CSRF Tokens\",\"OAuth2\",\"Webpack\"],\"correctAnswer\":[\"CORS\",\"CSRF Tokens\",\"OAuth2\"]},{\"questionText\":\"Which of the following are search algorithms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Binary Search\",\"Linear Search\",\"Bubble Sort\",\"Quick Sort\"],\"correctAnswer\":[\"Binary Search\",\"Linear Search\"]},{\"questionText\":\"Which of the following are caching mechanisms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Redis\",\"Memcached\",\"PostgreSQL\",\"Elasticsearch\"],\"correctAnswer\":[\"Redis\",\"Memcached\"]},{\"questionText\":\"Which of the following are Python web frameworks?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Django\",\"Flask\",\"FastAPI\",\"Angular\"],\"correctAnswer\":[\"Django\",\"Flask\",\"FastAPI\"]},{\"questionText\":\"Which of the following are automated testing types?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Unit Testing\",\"Integration Testing\",\"E2E Testing\",\"Manual Inspection\"],\"correctAnswer\":[\"Unit Testing\",\"Integration Testing\",\"E2E Testing\"]},{\"questionText\":\"Which of the following are version control platforms?\",\"questionType\":\"MULTIPL