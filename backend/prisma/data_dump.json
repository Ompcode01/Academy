      "quizConfigJson": "{\"title\":\"Knowledge check\",\"description\":\"\",\"durationMinutes\":46,\"passingPercentage\":70,\"maxAttempts\":1,\"totalMarks\":160,\"shuffleQuestions\":true,\"showAnswersAfterSubmit\":true,\"oneQuestionAtATime\":false,\"questions\":[{\"questionText\":\"What does HTML stand for?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Hyper Text Markup Language\",\"High Text Machine Language\",\"Hyper Tabular Markup Language\",\"None of the above\"],\"correctAnswer\":\"Hyper Text Markup Language\"},{\"questionText\":\"Which CSS property controls text size?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"font-size\",\"text-style\",\"font-weight\",\"text-size\"],\"correctAnswer\":\"font-size\"},{\"questionText\":\"What is the time complexity of binary search?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"O(1)\",\"O(n)\",\"O(log n)\",\"O(n^2)\"],\"correctAnswer\":\"O(log n)\"},{\"questionText\":\"Which SQL keyword is used to retrieve data from a database?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"GET\",\"SELECT\",\"FETCH\",\"EXTRACT\"],\"correctAnswer\":\"SELECT\"},{\"questionText\":\"Which data structure uses FIFO (First In First Out)?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Stack\",\"Queue\",\"Tree\",\"Graph\"],\"correctAnswer\":\"Queue\"},{\"questionText\":\"What does API stand for in software engineering?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Application Programming Interface\",\"Automated Program Integration\",\"Advanced Processing Interface\",\"Application Process Implementation\"],\"correctAnswer\":\"Application Programming Interface\"},{\"questionText\":\"Which HTTP status code signifies Success?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"200\",\"404\",\"500\",\"301\"],\"correctAnswer\":\"200\"},{\"questionText\":\"In JavaScript\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"MCQ\",\"var\",\"let\",\"global\"],\"correctAnswer\":\"set\"},{\"questionText\":\"Which protocol is secured with TLS/SSL encryption?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"HTTP\",\"HTTPS\",\"FTP\",\"SMTP\"],\"correctAnswer\":\"HTTPS\"},{\"questionText\":\"What is the primary function of a Vector Database in AI?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Storing user credentials\",\"Semantic similarity search on embeddings\",\"Processing relational joins\",\"Hosting static HTML files\"],\"correctAnswer\":\"Semantic similarity search on embeddings\"},{\"questionText\":\"Which Git command is used to record changes in the repository?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"git push\",\"git commit\",\"git checkout\",\"git init\"],\"correctAnswer\":\"git commit\"},{\"questionText\":\"What is the default port number for HTTP servers?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"21\",\"22\",\"80\",\"443\"],\"correctAnswer\":\"80\"},{\"questionText\":\"Which keyword is used in Python to define a function?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"function\",\"func\",\"def\",\"procedure\"],\"correctAnswer\":\"def\"},{\"questionText\":\"What does JSON stand for?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"JavaScript Object Notation\",\"Java Server Object Network\",\"JavaScript Syntax Oriented Node\",\"Java Structured Object Naming\"],\"correctAnswer\":\"JavaScript Object Notation\"},{\"questionText\":\"Which data structure operates on LIFO (Last In First Out)?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Queue\",\"Stack\",\"LinkedList\",\"Heap\"],\"correctAnswer\":\"Stack\"},{\"questionText\":\"What HTTP method is typically used to create a new resource?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"GET\",\"POST\",\"PUT\",\"DELETE\"],\"correctAnswer\":\"POST\"},{\"questionText\":\"Which component in Docker packages an application and its dependencies?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Container\",\"Volume\",\"Network\",\"Swarm\"],\"correctAnswer\":\"Container\"},{\"questionText\":\"In React\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"MCQ\",\"useState\",\"useEffect\",\"useContext\"],\"correctAnswer\":\"useReducer\"},{\"questionText\":\"Which SQL clause is used to filter aggregated records?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"WHERE\",\"HAVING\",\"GROUP BY\",\"ORDER BY\"],\"correctAnswer\":\"HAVING\"},{\"questionText\":\"What does REST stand for in web API architecture?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Representational State Transfer\",\"Remote Execution System Tech\",\"Reliable Storage Technology\",\"Response Endpoint Transfer\"],\"correctAnswer\":\"Representational State Transfer\"},{\"questionText\":\"CSS is used to structure content on a webpage.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"Python is a statically typed programming language.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"HTTP is a stateless protocol.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"In SQL\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"TRUE_FALSE\"],\"correctAnswer\":\"\"},{\"questionText\":\"Docker containers share the host machine OS kernel.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"JavaScript executes strictly on single-threaded event loops.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Git is a centralized version control system.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"REST APIs require XML payloads for all request data.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"TypeScript is a typed superset of JavaScript that compiles to plain JS.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Indexing