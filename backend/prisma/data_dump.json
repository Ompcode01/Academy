      "isPublished": false,
      "isActive": true,
      "quizConfigJson": "{\"title\":\"Knowledge Check\",\"description\":\"\",\"durationMinutes\":20,\"passingPercentage\":70,\"maxAttempts\":3,\"totalMarks\":160,\"shuffleQuestions\":false,\"showAnswersAfterSubmit\":true,\"oneQuestionAtATime\":true,\"questions\":[{\"questionText\":\"What does HTML stand for?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Hyper Text Markup Language\",\"High Text Machine Language\",\"Hyper Tabular Markup Language\",\"None of the above\"],\"correctAnswer\":\"Hyper Text Markup Language\"},{\"questionText\":\"Which CSS property controls text size?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"font-size\",\"text-style\",\"font-weight\",\"text-size\"],\"correctAnswer\":\"font-size\"},{\"questionText\":\"What is the time complexity of binary search?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"O(1)\",\"O(n)\",\"O(log n)\",\"O(n^2)\"],\"correctAnswer\":\"O(log n)\"},{\"questionText\":\"Which SQL keyword is used to retrieve data from a database?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"GET\",\"SELECT\",\"FETCH\",\"EXTRACT\"],\"correctAnswer\":\"SELECT\"},{\"questionText\":\"Which data structure uses FIFO (First In First Out)?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Stack\",\"Queue\",\"Tree\",\"Graph\"],\"correctAnswer\":\"Queue\"},{\"questionText\":\"What does API stand for in software engineering?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Application Programming Interface\",\"Automated Program Integration\",\"Advanced Processing Interface\",\"Application Process Implementation\"],\"correctAnswer\":\"Application Programming Interface\"},{\"questionText\":\"Which HTTP status code signifies Success?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"200\",\"404\",\"500\",\"301\"],\"correctAnswer\":\"200\"},{\"questionText\":\"In JavaScript\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"MCQ\",\"var\",\"let\",\"global\"],\"correctAnswer\":\"set\"},{\"questionText\":\"Which protocol is secured with TLS/SSL encryption?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"HTTP\",\"HTTPS\",\"FTP\",\"SMTP\"],\"correctAnswer\":\"HTTPS\"},{\"questionText\":\"What is the primary function of a Vector Database in AI?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Storing user credentials\",\"Semantic similarity search on embeddings\",\"Processing relational joins\",\"Hosting static HTML files\"],\"correctAnswer\":\"Semantic similarity search on embeddings\"},{\"questionText\":\"Which Git command is used to record changes in the repository?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"git push\",\"git commit\",\"git checkout\",\"git init\"],\"correctAnswer\":\"git commit\"},{\"questionText\":\"What is the default port number for HTTP servers?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"21\",\"22\",\"80\",\"443\"],\"correctAnswer\":\"80\"},{\"questionText\":\"Which keyword is used in Python to define a function?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"function\",\"func\",\"def\",\"procedure\"],\"correctAnswer\":\"def\"},{\"questionText\":\"What does JSON stand for?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"JavaScript Object Notation\",\"Java Server Object Network\",\"JavaScript Syntax Oriented Node\",\"Java Structured Object Naming\"],\"correctAnswer\":\"JavaScript Object Notation\"},{\"questionText\":\"Which data structure operates on LIFO (Last In First Out)?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Queue\",\"Stack\",\"LinkedList\",\"Heap\"],\"correctAnswer\":\"Stack\"},{\"questionText\":\"What HTTP method is typically used to create a new resource?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"GET\",\"POST\",\"PUT\",\"DELETE\"],\"correctAnswer\":\"POST\"},{\"questionText\":\"Which component in Docker packages an application and its dependencies?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Container\",\"Volume\",\"Network\",\"Swarm\"],\"correctAnswer\":\"Container\"},{\"questionText\":\"In React\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"MCQ\",\"useState\",\"useEffect\",\"useContext\"],\"correctAnswer\":\"useReducer\"},{\"questionText\":\"Which SQL clause is used to filter aggregated records?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"WHERE\",\"HAVING\",\"GROUP BY\",\"ORDER BY\"],\"correctAnswer\":\"HAVING\"},{\"questionText\":\"What does REST stand for in web API architecture?\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"Representational State Transfer\",\"Remote Execution System Tech\",\"Reliable Storage Technology\",\"Response Endpoint Transfer\"],\"correctAnswer\":\"Representational State Transfer\"},{\"questionText\":\"CSS is used to structure content on a webpage.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"Python is a statically typed programming language.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"HTTP is a stateless protocol.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"In SQL\",\"questionType\":\"MCQ\",\"marks\":2,\"options\":[\"TRUE_FALSE\"],\"correctAnswer\":\"\"},{\"questionText\":\"Docker containers share the host machine OS kernel.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"JavaScript executes strictly on single-threaded event loops.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Git is a centralized version control system.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"REST APIs require XML payloads for all request data.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"TypeScript is a typed superset of JavaScript that compiles to plain JS.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Indexing a database table always increases write performance.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"GraphQL APIs allow clients to request exact fields needed.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Microservices architecture requires a single monolithic database.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"JSON supports binary blob data types natively.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"Redis is an in-memory key-value data store.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"React components re-render whenever state changes.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"JWT tokens are encrypted by default.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"The DOM represents an HTML document as a tree structure.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"A stack overflow error occurs when call stack limit is exceeded.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Kubernetes is an open-source container orchestration platform.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"True\"},{\"questionText\":\"Agile methodology relies exclusively on rigid upfront waterfall planning.\",\"questionType\":\"TRUE_FALSE\",\"marks\":2,\"correctAnswer\":\"False\"},{\"questionText\":\"Which of the following are programming languages?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Python\",\"HTML\",\"Java\",\"CSS\"],\"correctAnswer\":[\"Python\",\"Java\"]},{\"questionText\":\"Which of the following are HTTP request methods?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"GET\",\"POST\",\"FETCH\",\"DELETE\"],\"correctAnswer\":[\"GET\",\"POST\",\"DELETE\"]},{\"questionText\":\"Which of the following are relational database management systems?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"PostgreSQL\",\"MongoDB\",\"MySQL\",\"Redis\"],\"correctAnswer\":[\"PostgreSQL\",\"MySQL\"]},{\"questionText\":\"Which of the following are frontend web technologies?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"React\",\"Vue.js\",\"Node.js\",\"CSS\"],\"correctAnswer\":[\"React\",\"Vue.js\",\"CSS\"]},{\"questionText\":\"Which of the following are Agile development frameworks?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Scrum\",\"Kanban\",\"Waterfall\",\"PRINCE2\"],\"correctAnswer\":[\"Scrum\",\"Kanban\"]},{\"questionText\":\"Which of the following are cloud service providers?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"AWS\",\"Azure\",\"GitHub\",\"GCP\"],\"correctAnswer\":[\"AWS\",\"Azure\",\"GCP\"]},{\"questionText\":\"Which of the following are primitive data types in JavaScript?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"String\",\"Number\",\"Boolean\",\"ArrayList\"],\"correctAnswer\":[\"String\",\"Number\",\"Boolean\"]},{\"questionText\":\"Which of the following are NoSQL databases?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"MongoDB\",\"Cassandra\",\"Oracle\",\"PostgreSQL\"],\"correctAnswer\":[\"MongoDB\",\"Cassandra\"]},{\"questionText\":\"Which of the following are CSS layout modules?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Flexbox\",\"Grid\",\"DOM\",\"Canvas\"],\"correctAnswer\":[\"Flexbox\",\"Grid\"]},{\"questionText\":\"Which of the following are continuous integration tools?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Jenkins\",\"GitHub Actions\",\"Docker\",\"Git\"],\"correctAnswer\":[\"Jenkins\",\"GitHub Actions\"]},{\"questionText\":\"Which of the following are container technologies?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Docker\",\"Podman\",\"Nginx\",\"Apache\"],\"correctAnswer\":[\"Docker\",\"Podman\"]},{\"questionText\":\"Which of the following are valid Linux operating systems?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Ubuntu\",\"Debian\",\"Windows\",\"Fedora\"],\"correctAnswer\":[\"Ubuntu\",\"Debian\",\"Fedora\"]},{\"questionText\":\"Which of the following are HTTP client libraries in JavaScript?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Axios\",\"Fetch API\",\"Express\",\"Prisma\"],\"correctAnswer\":[\"Axios\",\"Fetch API\"]},{\"questionText\":\"Which of the following are web security mechanisms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"CORS\",\"CSRF Tokens\",\"OAuth2\",\"Webpack\"],\"correctAnswer\":[\"CORS\",\"CSRF Tokens\",\"OAuth2\"]},{\"questionText\":\"Which of the following are search algorithms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Binary Search\",\"Linear Search\",\"Bubble Sort\",\"Quick Sort\"],\"correctAnswer\":[\"Binary Search\",\"Linear Search\"]},{\"questionText\":\"Which of the following are caching mechanisms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Redis\",\"Memcached\",\"PostgreSQL\",\"Elasticsearch\"],\"correctAnswer\":[\"Redis\",\"Memcached\"]},{\"questionText\":\"Which of the following are Python web frameworks?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Django\",\"Flask\",\"FastAPI\",\"Angular\"],\"correctAnswer\":[\"Django\",\"Flask\",\"FastAPI\"]},{\"questionText\":\"Which of the following are automated testing types?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Unit Testing\",\"Integration Testing\",\"E2E Testing\",\"Manual Inspection\"],\"correctAnswer\":[\"Unit Testing\",\"Integration Testing\",\"E2E Testing\"]},{\"questionText\":\"Which of the following are version control platforms?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"GitHub\",\"GitLab\",\"Bitbucket\",\"Jira\"],\"correctAnswer\":[\"GitHub\",\"GitLab\",\"Bitbucket\"]},{\"questionText\":\"Which of the following are essential components of RAG architecture?\",\"questionType\":\"MULTIPLE_SELECT\",\"marks\":2,\"options\":[\"Embeddings\",\"Vector Index\",\"LLM\",\"CSS\"],\"correctAnswer\":[\"Embeddings\",\"Vector Index\",\"LLM\"]},{\"questionText\":\"What does API stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Application Programming Interface\"},{\"questionText\":\"What does SQL stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Structured Query Language\"},{\"questionText\":\"What does URL stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Uniform Resource Locator\"},{\"questionText\":\"What does CSS stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Cascading Style Sheets\"},{\"questionText\":\"What is the capital of France?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Paris\"},{\"questionText\":\"What command is used to clone a Git repository?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"git clone\"},{\"questionText\":\"What command is used to install npm dependencies?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"npm install\"},{\"questionText\":\"What does CPU stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Central Processing Unit\"},{\"questionText\":\"What keyword is used to declare a constant in JavaScript?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"const\"},{\"questionText\":\"What protocol encrypts web communication over port 443?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"HTTPS\"},{\"questionText\":\"What does RAM stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Random Access Memory\"},{\"questionText\":\"What does SDK stand for?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Software Development Kit\"},{\"questionText\":\"What command initializes a new Git repository?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"git init\"},{\"questionText\":\"What does DOM stand for in web browsers?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Document Object Model\"},{\"questionText\":\"What is the standard port for HTTPS connections?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"443\"},{\"questionText\":\"What does DNS stand for in networking?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Domain Name System\"},{\"questionText\":\"What does IP stand for in IP address?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Internet Protocol\"},{\"questionText\":\"What command builds a Docker image from a Dockerfile?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"docker build\"},{\"questionText\":\"What format does JSON use for data exchange?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"Text\"},{\"questionText\":\"What keyword handles exceptions in Python try blocks?\",\"questionType\":\"SHORT_ANSWER\",\"marks\":2,\"correctAnswer\":\"except\"}]}",
