generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id                BigInt             @id @default(autoincrement())
  departmentCode    String             @unique @db.VarChar(20)
  departmentName    String             @unique @db.VarChar(100)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courses           Course[]
  employees         Employee[]
  events            Event[]
  guestAccessGrants GuestAccessGrant[]

  @@map("departments")
}

model Employee {
  id                 BigInt             @id @default(autoincrement())
  employeeCode       String             @unique @db.VarChar(20)
  firstName          String             @db.VarChar(100)
  lastName           String             @db.VarChar(100)
  officialEmail      String             @unique @db.VarChar(255)
  phoneNumber        String?            @db.VarChar(20)
  designation        String             @db.VarChar(100)
  departmentId       BigInt
  managerId          BigInt?
  joiningDate        DateTime
  profileImage       String?            @db.VarChar(500)
  employmentStatus   EmploymentStatus   @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assignedCourses    CourseTeacher[]
  createdCourses     Course[]
  department         Department         @relation(fields: [departmentId], references: [id])
  manager            Employee?          @relation("ManagerEmployees", fields: [managerId], references: [id])
  subordinates       Employee[]         @relation("ManagerEmployees")
  enrollments        Enrollment[]
  grantedGuestGrants GuestAccessGrant[] @relation("GrantedByEmployee")
  guestGrants        GuestAccessGrant[] @relation("GuestUserGrants")
  userAccount        UserAccount?
  rolesAssigned      UserRole[]         @relation("AssignedByEmployee")
  assignedRoles      UserRole[]

  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model UserAccount {
  id                  BigInt    @id @default(autoincrement())
  employeeId          BigInt    @unique
  username            String    @unique @db.VarChar(100)
  passwordHash        String    @db.VarChar(255)
  lastLogin           DateTime?
  failedLoginAttempts Int       @default(0)
  accountLocked       Boolean   @default(false)
  passwordChangedAt   DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  employee            Employee  @relation(fields: [employeeId], references: [id])

  @@map("user_accounts")
}

model Role {
  id              BigInt           @id @default(autoincrement())
  roleName        String           @unique @db.VarChar(100)
  roleCode        String           @unique @db.VarChar(20)
  description     String?          @db.VarChar(255)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              BigInt           @id @default(autoincrement())
  permissionName  String           @db.VarChar(100)
  permissionCode  String           @unique @db.VarChar(100)
  moduleName      String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([moduleName])
  @@map("permissions")
}

model UserRole {
  id                 BigInt    @id @default(autoincrement())
  employeeId         BigInt
  roleId             BigInt
  assignedBy         BigInt?
  assignedAt         DateTime  @default(now())
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  assignedByEmployee Employee? @relation("AssignedByEmployee", fields: [assignedBy], references: [id])
  employee           Employee  @relation(fields: [employeeId], references: [id])
  role               Role      @relation(fields: [roleId], references: [id])

  @@unique([employeeId, roleId])
  @@index([employeeId])
  @@index([roleId])
  @@index([assignedBy], map: "user_roles_assignedBy_fkey")
  @@map("user_roles")
}

model RolePermission {
  id           BigInt     @id @default(autoincrement())
  roleId       BigInt
  permissionId BigInt
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Category {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@map("categories")
}

model Course {
  id                    BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId            BigInt               @db.UnsignedBigInt
  departmentId          BigInt?
  creatorId             BigInt
  title                 String               @db.VarChar(200)
  shortDescription      String?              @db.VarChar(500)
  description           String?              @db.Text
  thumbnail             String?              @db.VarChar(255)
  duration              Int?
  level                 String?              @db.VarChar(50)
  language              String?              @db.VarChar(50)
  status                CourseStatus         @default(DRAFT)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  enrollmentType        String               @default("SELF") @db.VarChar(50)
  isMandatory           Boolean              @default(false)
  /// Wizard step the creator last left off on. Only meaningful while the course
  /// is still a DRAFT - it lets an abandoned or cancelled creation resume from
  /// exactly where it stopped instead of starting over.
  draftStep             Int?
  courseCode            String?              @db.VarChar(50)
  shortName             String?              @db.VarChar(100)
  exactDurationSeconds  Int                  @default(0)
  targetDurationMinutes Int?
  certificateTemplate   CertificateTemplate?
  sections              CourseSection[]
  teachers              CourseTeacher[]
  category              Category             @relation(fields: [categoryId], references: [id])
  creator               Employee             @relation(fields: [creatorId], references: [id])
  department            Department?          @relation(fields: [departmentId], references: [id])
  enrollments           Enrollment[]

  @@index([categoryId], map: "courses_categoryId_fkey")
  @@index([departmentId])
  @@index([creatorId])
  @@map("courses")
}

model CourseTeacher {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  courseId   BigInt   @db.UnsignedBigInt
  teacherId  BigInt
  assignedAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher    Employee @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
  @@map("course_teachers")
}

model CourseSection {
  id                    BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  courseId              BigInt            @db.UnsignedBigInt
  title                 String            @db.VarChar(200)
  description           String?           @db.VarChar(500)
  sectionOrder          Int
  isPublished           Boolean           @default(false)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  exactDurationSeconds  Int               @default(0)
  targetDurationMinutes Int?
  course                Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contents              LearningContent[]

  @@index([courseId])
  @@map("course_sections")
}

model LearningContent {
  id                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  sectionId            BigInt        @db.UnsignedBigInt
  title                String        @db.VarChar(200)
  contentType          String        @db.VarChar(50)
  contentUrl           String?       @db.VarChar(500)
  description          String?       @db.Text
  duration             Int?
  contentOrder         Int
  isMandatory          Boolean       @default(false)
  isPublished          Boolean       @default(false)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  assignmentConfigJson String?       @db.Text
  quizConfigJson       String?       @db.Text
  durationMetadata     String?       @db.Text
  durationSource       String        @default("CALCULATED") @db.VarChar(50)
  exactDurationSeconds Int           @default(0)
  section              CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("learning_contents")
}

model Enrollment {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt
  courseId         BigInt    @db.UnsignedBigInt
  enrolledAt       DateTime  @default(now())
  completedAt      DateTime?
  status           String    @default("IN_PROGRESS") @db.VarChar(30)
  progress         Decimal   @default(0.00) @db.Decimal(5, 2)
  createdAt        DateTime  @default(now())
  dueDate          DateTime?
  isMandatory      Boolean   @default(false)
  lastActivityAt   DateTime?
  sessionsCount    Int       @default(1)
  startDate        DateTime?
  timeSpentSeconds Int       @default(0)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             Employee  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model UserLessonProgress {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId                BigInt
  courseId              BigInt    @db.UnsignedBigInt
  contentId             BigInt    @db.UnsignedBigInt
  isCompleted           Boolean   @default(false)
  completedAt           DateTime?
  activeLearningSeconds Int       @default(0)
  lastActivityAt        DateTime  @default(now()) @updatedAt
  lastPosition          Float     @default(0)
  watchedSeconds        Int       @default(0)

  @@unique([userId, contentId])
  @@index([userId, courseId])
  @@map("user_lesson_progress")
}

model AssessmentSubmission {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt
  courseId       BigInt    @db.UnsignedBigInt
  contentId      BigInt?   @db.UnsignedBigInt
  submissionType String    @default("QUIZ") @db.VarChar(50)
  answersJson    String?   @db.Text
  submissionText String?   @db.Text
  fileUrl        String?   @db.VarChar(500)
  status         String    @default("SUBMITTED") @db.VarChar(30)
  score          Float     @default(0)
  maxScore       Float     @default(100)
  percentage     Float     @default(0)
  grade          String?   @db.VarChar(20)
  feedback       String?   @db.Text
  attemptNumber  Int       @default(1)
  gradedBy       String?   @db.VarChar(100)
  gradedAt       DateTime?
  submittedAt    DateTime  @default(now())

  @@index([userId, courseId])
  @@index([contentId])
  @@map("assessment_submissions")
}

model Skill {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name        String      @unique @db.VarChar(100)
  category    String      @db.VarChar(100)
  subCategory String?     @db.VarChar(100)
  skillType   String      @default("Technical Skill") @db.VarChar(50)
  description String?     @db.VarChar(500)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userSkills  UserSkill[]

  @@map("skills")
}

model UserSkill {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt
  skillId          BigInt?        @db.UnsignedBigInt
  skillName        String         @db.VarChar(100)
  category         String         @db.VarChar(100)
  subCategory      String?        @db.VarChar(100)
  skillType        String         @default("Technical Skill") @db.VarChar(50)
  proficiencyLevel String         @default("Intermediate") @db.VarChar(50)
  rating           Int            @default(3)
  yearsOfExp       Decimal?       @db.Decimal(4, 1)
  description      String?        @db.Text
  status           ApprovalStatus @default(PENDING)
  rejectionReason  String?        @db.Text
  verifiedBy       String?        @db.VarChar(100)
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  skill            Skill?         @relation(fields: [skillId], references: [id])

  @@index([userId])
  @@index([skillId])
  @@index([status])
  @@map("user_skills")
}

model UserProject {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt
  projectName      String         @db.VarChar(200)
  projectType      String         @default("Internal") @db.VarChar(100)
  organization     String?        @db.VarChar(200)
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean        @default(false)
  roleName         String?        @db.VarChar(100)
  responsibilities String?        @db.Text
  technologies     String?        @db.VarChar(500)
  status           ApprovalStatus @default(PENDING)
  rejectionReason  String?        @db.Text
  verifiedBy       String?        @db.VarChar(100)
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@map("user_projects")
}

model SkillApprovalLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  requestType String   @db.VarChar(50)
  requestId   BigInt   @db.UnsignedBigInt
  action      String   @db.VarChar(50)
  actorId     BigInt?
  actorName   String?  @db.VarChar(100)
  comments    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([requestType, requestId])
  @@map("skill_approval_logs")
}

model Notification {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(200)
  message    String   @db.Text
  link       String?  @db.VarChar(500)
  isRead     Boolean  @default(false)
  metadata   Json?
  roleTarget String?  @db.VarChar(20)
  createdAt  DateTime @default(now())
  actorId    BigInt?
  category   String   @default("GENERAL") @db.VarChar(50)
  entityId   BigInt?  @db.UnsignedBigInt
  entityType String?  @db.VarChar(50)
  priority   String   @default("NORMAL") @db.VarChar(20)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, category])
  @@index([category])
  @@index([roleTarget])
  @@map("notifications")
}

model CertificateTemplate {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  courseId          BigInt?  @unique @db.UnsignedBigInt
  templateName      String   @default("Harbinger Classic Gold") @db.VarChar(100)
  logoUrl           String?  @db.Text
  headerTitle       String   @default("CERTIFICATE") @db.VarChar(100)
  headerSubtitle    String   @default("OF ACHIEVEMENT") @db.VarChar(100)
  certifyText       String   @default("This is to certify that") @db.VarChar(255)
  completionText    String   @default("has successfully completed and passed the course") @db.VarChar(255)
  signatoryName     String   @default("Richard Wilson") @db.VarChar(100)
  signatoryTitle    String   @default("Authorized Director") @db.VarChar(100)
  signatureUrl      String?  @db.Text
  customDate        String?  @db.VarChar(50)
  borderStyle       String   @default("GOLD_DOUBLE_ORNATE") @db.VarChar(50)
  primaryColor      String   @default("#d97706") @db.VarChar(20)
  enableCertificate Boolean  @default(true)
  passingThreshold  Int      @default(70)
  validityDays      Int      @default(365)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  course            Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("certificate_templates")
}

model IssuedCertificate {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  certificateCode  String    @unique @db.VarChar(50)
  userId           BigInt
  courseId         BigInt    @db.UnsignedBigInt
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  status           String    @default("ACTIVE") @db.VarChar(30)
  recipientName    String    @db.VarChar(100)
  courseTitle      String    @db.VarChar(200)
  templateSnapshot String?   @db.Text

  @@index([userId])
  @@index([courseId])
  @@map("issued_certificates")
}

model Event {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  title        String      @db.VarChar(200)
  description  String?     @db.Text
  eventDate    DateTime
  eventTime    String?     @db.VarChar(20)
  url          String?     @db.VarChar(500)
  eventType    String      @default("site") @db.VarChar(50)
  courseId     BigInt?     @db.UnsignedBigInt
  departmentId BigInt?
  creatorId    BigInt?
  creatorName  String?     @db.VarChar(100)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  reminderSent Boolean     @default(false)
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([eventDate])
  @@index([eventType])
  @@index([departmentId])
  @@map("events")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  timestamp      DateTime @default(now())
  actorId        BigInt?
  actorName      String   @default("System") @db.VarChar(100)
  username       String?  @db.VarChar(100)
  departmentName String?  @db.VarChar(100)
  action         String   @db.VarChar(100)
  detail         String   @db.Text
  type           String   @default("system") @db.VarChar(50)
  ipAddress      String?  @db.VarChar(50)

  @@index([type])
  @@index([timestamp])
  @@index([username])
  @@index([departmentName])
  @@map("audit_logs")
}

model GuestAccessGrant {
  id           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt?
  departmentId BigInt?
  scope        GuestAccessScope @default(DEPARTMENT)
  grantedById  BigInt
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  grantedBy    Employee         @relation("GrantedByEmployee", fields: [grantedById], references: [id])
  user         Employee?        @relation("GuestUserGrants", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([departmentId])
  @@index([scope])
  @@index([grantedById], map: "guest_access_grants_grantedById_fkey")
  @@map("guest_access_grants")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  DELETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GuestAccessScope {
  GLOBAL
  DEPARTMENT
}
