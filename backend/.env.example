# Harbinger Academy LMS Backend Environment Configuration

PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION OPTIONS
# -----------------------------------------------------------------------------
# Option A: Local Container MySQL Database (Default for single laptop development)
DATABASE_URL="mysql://root:rootpassword@localhost:3307/academy_lms"

# Option B: Central Shared MySQL Database Server (Multi-laptop / Team deployment)
# Replace <SHARED_DB_HOST_IP> with the IP address or hostname of your central MySQL server
# DATABASE_URL="mysql://root:rootpassword@<SHARED_DB_HOST_IP>:3306/academy_lms"
# -----------------------------------------------------------------------------

JWT_SECRET="supersecretjwtkey"
JWT_EXPIRES_IN="1d"
LOG_LEVEL="debug"